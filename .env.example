# Neon connection string (Neon console → your project → Connection string, "pooled" is fine)
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth: a long random secret (e.g. `openssl rand -base64 32`) and the site's public URL
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated list of emails allowed to create an admin account and sign in to /admin
ADMIN_EMAILS="you@example.com"

# Optional: your Amazon Associates tag, appended to every "Check price" link
NEXT_PUBLIC_AMAZON_TAG=""

# Public site URL, used for the sitemap and canonical links
NEXT_PUBLIC_SITE_URL="https://greenjuicetribe.com"
